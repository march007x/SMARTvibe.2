# ============================================================
#  secrets.toml.example
#  คัดลอกเป็น .streamlit/secrets.toml แล้วกรอกค่าจริง
#  secrets.toml อยู่ใน .gitignore แล้ว จะไม่ถูก push
#
#  ถ้า deploy บน Streamlit Cloud: ไม่ต้องอัปโหลดไฟล์นี้
#  ให้ไปวางเนื้อหาใน Settings -> Secrets ของแอปแทน
# ============================================================

# ---------- บังคับต้องมี ----------
# ต้องตรงกับ FIREBASE_HOST ในเฟิร์มแวร์เป๊ะ ๆ
# ห้ามมี https:// ข้างหน้า และห้ามมี / ปิดท้าย
FIREBASE_DOMAIN = "mmmmmm-1a2fc-default-rtdb.asia-southeast1.firebasedatabase.app"
FIREBASE_TOKEN  = "JpSe3sGbqrkL92Ko5FIZs66bQzLxXWcavXKWmpmn"

# ---------- ทางเลือก: แจ้งเตือน Telegram ----------
# BotFather -> /newbot -> ได้ TOKEN
# ทักบอทตัวเอง 1 ครั้ง แล้วคุยกับ @userinfobot -> ได้ CHAT_ID
