#pragma once

#define WIFI_SSID      "ชื่อ WiFi ของคุณ"
#define WIFI_PASSWORD  "รหัสผ่าน WiFi"

// Firebase Console → ⚙️ Project settings → Service accounts
//                  → Database secrets → Show → คัดลอกมาวาง
#define FIREBASE_AUTH  "วาง database secret ที่นี่"

// Realtime Database → Data → คัดลอก URL แล้วตัด https:// กับ / ท้ายออก
#define FIREBASE_HOST  "xxxxx-default-rtdb.asia-southeast1.firebasedatabase.app"
